{
  "description": "task-workflow 環境醫生：SessionStart 跑 doctor --check（a～f 全項）；Bash／PowerShell 含 git 的指令前跑輕量 lock／ownership 守護。指令以 bash 明確執行，不依賴 shebang 與執行權限（Windows NTFS、hook 由其他 shell 啟動時仍可跑）。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/tools/doctor.sh\" --check --hook --no-fetch",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/git-guard.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
